<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>✈️ SkyBooker · Flight Tickets</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    <!-- HEADER -->
    <header>
      <h1>✈️ SkyBooker</h1>
      <p>Select your flight, pick your seat, and fly away!</p>
    </header>

    <!-- FLIGHT SELECTION -->
    <div class="section-title">🛫 Available Flights</div>
    <div class="flight-grid" id="flightGrid">
      <% flights.forEach(flight => { %>
        <div class="flight-card" data-flight-id="<%= flight.id %>" data-price="<%= flight.price %>">
          <div class="airline">
            <span><%= flight.airline %></span>
            <span>✈️</span>
          </div>
          <div class="route">
            <span><%= flight.from %></span>
            <span>→</span>
            <span><%= flight.to %></span>
          </div>
          <div class="details">
            <span>⏰ <%= flight.time %></span>
            <span>Flight: <%= flight.id %></span>
          </div>
          <div class="price">$<%= flight.price %></div>
        </div>
      <% }) %>
    </div>

    <!-- SEAT MAP -->
    <div class="seat-section">
      <div class="section-title">💺 Choose Your Seats</div>
      <div class="cabin-layout" id="seatMap">
        <!-- Seat rows will be generated by JavaScript -->
      </div>
    </div>

    <!-- SUMMARY & BOOKING -->
    <div class="booking-summary">
      <div class="summary-info">
        <div class="summary-item">
          <span class="summary-label">Flight</span>
          <span class="summary-value" id="selectedFlight">—</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Seats</span>
          <span class="summary-value" id="selectedSeats">—</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Total</span>
          <span class="summary-value total-price" id="totalPrice">$0</span>
        </div>
      </div>
      <button class="book-btn" id="bookBtn" disabled>🎟️ Book Flight</button>
    </div>

    <!-- TOAST MESSAGE -->
    <div class="toast" id="toastMessage">
      <span>💡</span> Select a flight and seats to continue.
    </div>
  </div>

  <script>
    // Pass data from server to JavaScript
    const occupiedSeats = new Set(<%- JSON.stringify(occupiedSeats) %>);
    const flights = <%- JSON.stringify(flights) %>;

    // Configuration
    const rows = ['1', '2', '3', '4', '5', '6'];
    const columns = ['A', 'B', 'C', 'D', 'E', 'F'];
    let selectedFlightId = null;
    let selectedSeats = new Set();

    // DOM Elements
    const flightCards = document.querySelectorAll('.flight-card');
    const seatMap = document.getElementById('seatMap');
    const selectedFlightEl = document.getElementById('selectedFlight');
    const selectedSeatsEl = document.getElementById('selectedSeats');
    const totalPriceEl = document.getElementById('totalPrice');
    const bookBtn = document.getElementById('bookBtn');
    const toastMessage = document.getElementById('toastMessage');

    // --- TOAST HELPER ---
    function showToast(message, emoji = '💡', color = '#0284c7') {
      toastMessage.innerHTML = `<span>${emoji}</span> ${message}`;
      toastMessage.style.borderLeftColor = color;
    }

    // --- RENDER SEATS ---
    function renderSeats() {
      seatMap.innerHTML = '';
      rows.forEach(row => {
        const rowDiv = document.createElement('div');
        rowDiv.className = 'seat-row';

        // Row number
        const rowNum = document.createElement('div');
        rowNum.className = 'row-number';
        rowNum.textContent = row;
        rowDiv.appendChild(rowNum);

        columns.forEach((col, index) => {
          // Add aisle after column C
          if (index === 3) {
            const aisle = document.createElement('div');
            aisle.className = 'aisle';
            rowDiv.appendChild(aisle);
          }

          const seatLabel = `${row}${col}`;
          const seatDiv = document.createElement('div');
          seatDiv.className = 'seat';
          seatDiv.dataset.seat = seatLabel;
          seatDiv.textContent = seatLabel;

          if (occupiedSeats.has(seatLabel)) {
            seatDiv.classList.add('occupied');
          } else {
            seatDiv.classList.add('available');
            if (selectedSeats.has(seatLabel)) {
              seatDiv.classList.add('selected');
            }
            seatDiv.addEventListener('click', () => {
              if (occupiedSeats.has(seatLabel)) return;
              
              if (selectedSeats.has(seatLabel)) {
                selectedSeats.delete(seatLabel);
                seatDiv.classList.remove('selected');
              } else {
                selectedSeats.add(seatLabel);
                seatDiv.classList.add('selected');
              }
              updateSummary();
            });
          }
          rowDiv.appendChild(seatDiv);
        });
        seatMap.appendChild(rowDiv);
      });
    }

    // --- UPDATE SUMMARY ---
    function updateSummary() {
      const flight = flights.find(f => f.id === selectedFlightId);
      
      // Update flight name
      if (flight) {
        selectedFlightEl.textContent = `${flight.from} → ${flight.to} (${flight.airline})`;
      } else {
        selectedFlightEl.textContent = '—';
      }

      // Update seats
      if (selectedSeats.size === 0) {
        selectedSeatsEl.textContent = '—';
      } else {
        selectedSeatsEl.textContent = Array.from(selectedSeats).sort().join(', ');
      }

      // Update total price
      let total = 0;
      if (flight) {
        total = selectedSeats.size * flight.price;
      }
      totalPriceEl.textContent = `$${total.toFixed(2)}`;

      // Enable/disable book button
      bookBtn.disabled = !(selectedFlightId && selectedSeats.size > 0);
    }

    // --- FLIGHT CARD SELECTION ---
    flightCards.forEach(card => {
      card.addEventListener('click', () => {
        const flightId = card.dataset.flightId;
        if (selectedFlightId === flightId) return;

        selectedFlightId = flightId;
        
        // Update UI for selected card
        flightCards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        
        updateSummary();
        const flight = flights.find(f => f.id === flightId);
        showToast(`Selected ${flight.airline} flight to ${flight.to}`, '✈️', '#0284c7');
      });
    });

    // --- BOOKING ACTION ---
    bookBtn.addEventListener('click', async () => {
      if (!selectedFlightId || selectedSeats.size === 0) return;

      const flight = flights.find(f => f.id === selectedFlightId);
      const seatsArray = Array.from(selectedSeats).sort();

      bookBtn.disabled = true;
      showToast('Processing booking...', '⏳', '#64748b');

      try {
        const response = await fetch('/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            flightId: selectedFlightId,
            seats: seatsArray
          })
        });

        const result = await response.json();

        if (result.success) {
          showToast(`✅ ${result.message} (Ref: ${result.bookingRef})`, '🎟️', '#10b981');
          
          // Mark newly booked seats as occupied locally
          seatsArray.forEach(seat => occupiedSeats.add(seat));
          selectedSeats.clear();
          
          // Re-render seats and update summary
          renderSeats();
          updateSummary();
          
          setTimeout(() => {
            showToast('Have a great flight! 🌍', '🎉', '#0284c7');
          }, 1500);
        } else {
          showToast(`❌ ${result.message}`, '⚠️', '#ef4444');
          updateSummary();
        }
      } catch (error) {
        showToast('❌ Network error. Please try again.', '⚠️', '#ef4444');
        updateSummary();
      }
    });

    // --- INITIALIZATION ---
    renderSeats();
    updateSummary();

    // Pre-select the first flight for convenience
    if (flights.length > 0) {
      selectedFlightId = flights[0].id;
      document.querySelector(`.flight-card[data-flight-id="${selectedFlightId}"]`).classList.add('selected');
      updateSummary();
    }
  </script>
</body>
</html>
